%%{ init: { "theme": "default", "themeVariables": {
  "primaryColor": "#ffffff",
  "edgeLabelBackground": "#ffffff",
  "nodeTextColor": "#1a1a1a",
  "mainBkg": "#f2f2f2",
  "accentColor": "#cc0000",
  "fontSize": "14px",
  "clusterBkg": "#e6e6e6",
  "clusterBorder": "#999999"
} } }%%

flowchart TD
    classDef input fill:#ffffff,stroke:#999999;
    classDef process fill:#cc0000,stroke:#cc0000,color:#ffffff;
    classDef model fill:#ffffff,stroke:#cc0000,stroke-width:2px;
    classDef output fill:#ffffff,stroke:#000000;
    classDef memory fill:#f2f2f2,stroke:#666666,stroke-dasharray: 4;

    A["Pretrained LLM<br>(Base Model)"] --> B["Add Task-Specific Data"]
    class A model
    class B input

    B --> C["Fine-Tuning Process"]
    class C process

    C --> D["Fine-Tuned LLM<br>(Specialized Model)"]
    class D model

    D --> E["Deployed for Inference"]
    class E output

    subgraph "Training Assets"
        F["Labeled Examples<br>(Inputs + Outputs)"]
        G["Hyperparameters"]
    end
    class F,G memory

    F --> C
    G --> C
