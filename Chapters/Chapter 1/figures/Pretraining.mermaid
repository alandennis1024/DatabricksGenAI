%%{ init: { "theme": "default", "themeVariables": {
  "primaryColor": "#ffffff",
  "edgeLabelBackground": "#ffffff",
  "nodeTextColor": "#1a1a1a",
  "mainBkg": "#f2f2f2",
  "accentColor": "#cc0000",
  "fontSize": "14px",
  "clusterBkg": "#e6e6e6",
  "clusterBorder": "#999999"
} } }%%

flowchart TD
    classDef input fill:#ffffff,stroke:#999999;
    classDef process fill:#cc0000,stroke:#cc0000,color:#ffffff;
    classDef model fill:#ffffff,stroke:#cc0000,stroke-width:2px;
    classDef output fill:#ffffff,stroke:#000000;
    classDef memory fill:#f2f2f2,stroke:#666666,stroke-dasharray: 4;

    A["Raw Text Data<br>(Web, Books, Code)"] --> B["Data Cleaning & Tokenization"]
    class A input
    class B process

    B --> C["Pretraining"]
    class C process

    C --> D["Pretrained LLM<br>(Foundation Model)"]
    class D model

    D --> E["Used for<br>Fine-Tuning or Inference"]
    class E output

    subgraph "Pretraining Inputs"
        F["Compute Resources<br>(GPUs, TPUs, Memory)"]
        G["Model Architecture<br>(Layers, Parameters, Attention)"]
        H["Training Objective<br>(Next Token Prediction, MLM)"]
    end
    class F,G,H memory

    F --> C
    G --> C
    H --> C
