flowchart TD
    subgraph Input["Sensor / Input"]
        A[Observations]
        B[User Messages]
        C[Environment Data]
    end

    subgraph Brain["Brain"]
        D[Reasoning & Planning]
        E[Decision Making]
    end

    subgraph Memory["Memory"]
        F[Short-Term Context]
        G[Long-Term Knowledge]
    end

    subgraph Tools["Tools"]
        H[Code Execution]
        I[Search / Retrieval]
        J[APIs & Actions]
    end

    Input -->|perceives| Brain
    Brain -->|recalls / updates| Memory
    Memory -->|informs| Brain
    Brain -->|invokes| Tools
    Tools -->|returns results| Brain
    Brain -->|produces| Output([Response / Action])

    style Input fill:#e1f5ff,stroke:#01579b
    style Brain fill:#fff3e0,stroke:#e65100
    style Memory fill:#f3e5f5,stroke:#6a1b9a
    style Tools fill:#e8f5e9,stroke:#2e7d32
    style Output fill:#f5f5f5,stroke:#424242,stroke-width:2px
